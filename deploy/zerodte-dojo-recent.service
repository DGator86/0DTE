[Unit]
# Every ~2 trading days (Mon/Wed/Fri): review the last 10 recorded sessions +
# a medium universe sparring pass (10-day worlds, 2 generations). Deeper than
# the daily run; still not the full lattice. Never auto-promotes.
Description=0DTE dojo — recent-10-day review (every ~2 days)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zerodte
Group=zerodte
WorkingDirectory=/opt/zerodte
EnvironmentFile=/etc/zerodte/zerodte.env
ExecStart=/opt/zerodte/venv/bin/python dojo.py \
    --db /var/lib/zerodte/shadow.db \
    --record-dir /var/lib/zerodte/ticks \
    --configs-dir /var/lib/zerodte/configs \
    --reports-dir /var/lib/zerodte/reports/dojo \
    --recent-days 10 \
    --days 10 \
    --universes 8 \
    --generations 2 \
    --trials 15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zerodte

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerodte-dojo-recent

SuccessExitStatus=0
